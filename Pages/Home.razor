        new("❄️", "Refrigeración", "Instalar cooler de CPU aftermarket", "Reemplaza el cooler stock por uno de mayor rendimiento.", ["Cooler", "CPU", "Noctua", "be quiet!"], "Intermedio", "30 min"),
